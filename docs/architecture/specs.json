[
 {
  "key": "iris-demo",
  "title": "Kedro iris on SageMaker — three pipelines, one Model Registry",
  "subtitle": "Each SageMaker pipeline is one Processing step: `kedro run --env sagemaker --pipeline <name>`. The Kedro catalog does all I/O. Snowflake and the schedule are target design.",
  "desc": "A data scientist starts the train pipeline. Kedro reads iris.csv from S3 through its catalog, trains the model, writes the joblib file to S3, registers it as a new version in the Model Registry and sets the champion tag of the group to that version. The evaluate pipeline loads the champion, scores the fixed test split and stores the metrics as metadata of the version. On a schedule, the inference pipeline loads the champion, scores a batch and writes the predictions through the catalog.",
