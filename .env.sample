# Copy this file to .env and put your values in it. Do not commit .env.
#
# The deploy scripts read only these variables. If the environment already has
# AWS credentials or AWS_PROFILE, the scripts do not read .env.
#
# Use the credentials of an IAM user or role. Do not use root user credentials.

AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# Set this only for temporary credentials (for example, from AWS SSO).
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
